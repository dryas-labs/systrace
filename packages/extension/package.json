{
  "name": "systrace",
  "displayName": "DRYAS Systrace",
  "description": "SysML v2 editing and agent tools backed by a language engine.",
  "version": "0.1.22",
  "publisher": "dryas-labs",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.96.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dryas-labs/systrace.git",
    "directory": "packages/extension"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:sysml",
    "onLanguage:kerml",
    "onView:systrace.projects",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DRYAS starts configured local engine executables."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The engine reads saved files in a local extension-host workspace."
    }
  },
  "contributes": {
    "configurationDefaults": {
      "[sysml]": {
        "editor.wordBasedSuggestions": "off"
      },
      "[kerml]": {
        "editor.wordBasedSuggestions": "off"
      }
    },
    "languages": [
      {
        "id": "sysml",
        "aliases": [
          "SysML v2",
          "sysml"
        ],
        "extensions": [
          ".sysml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "kerml",
        "aliases": [
          "KerML",
          "kerml"
        ],
        "extensions": [
          ".kerml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "dryas.restartLanguageServer",
        "title": "DRYAS: Restart Language Server"
      },
      {
        "command": "dryas.showLanguageServiceStatus",
        "title": "DRYAS: Show Language Service Status"
      },
      {
        "command": "dryas.validateProject",
        "title": "DRYAS: Validate Saved Project"
      },
      {
        "command": "dryas.createProject",
        "title": "DRYAS: New Systrace Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "dryas.openProject",
        "title": "DRYAS: Open Systrace Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dryas.selectProject",
        "title": "DRYAS: Use Project",
        "icon": "$(check)"
      },
      {
        "command": "dryas.closeProject",
        "title": "DRYAS: Close Project",
        "icon": "$(close)"
      },
      {
        "command": "dryas.configureModelRoots",
        "title": "DRYAS: Configure Model Source Folders",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dryas.refreshProjects",
        "title": "DRYAS: Refresh Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "dryas.newNamespace",
        "title": "DRYAS: New Namespace…",
        "icon": "$(new-file)",
        "enablement": "workspaceFolderCount != 0"
      },
      {
        "command": "dryas.newNamespaceInFolder",
        "title": "DRYAS: New Namespace…",
        "icon": "$(new-file)"
      },
      {
        "command": "dryas.deleteNamespace",
        "title": "DRYAS: Delete Namespace…",
        "icon": "$(trash)"
      },
      {
        "command": "dryas.addProjectReference",
        "title": "DRYAS: Add Project Reference…",
        "icon": "$(add)"
      },
      {
        "command": "dryas.removeProjectReference",
        "title": "DRYAS: Remove Project Reference",
        "icon": "$(remove)"
      },
      {
        "command": "dryas.openReferencedProject",
        "title": "DRYAS: Open Referenced Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dryas.detailed.selectProject",
        "title": "DRYAS: Select Current Project"
      },
      {
        "command": "dryas.detailed.closeProject",
        "title": "DRYAS: Close Project"
      },
      {
        "command": "dryas.detailed.validateProject",
        "title": "DRYAS: Validate Saved Project"
      },
      {
        "command": "dryas.detailed.configureModelRoots",
        "title": "DRYAS: Configure Model Source Folders"
      },
      {
        "command": "dryas.detailed.newNamespace",
        "title": "DRYAS: New Namespace…"
      },
      {
        "command": "dryas.detailed.deleteNamespace",
        "title": "DRYAS: Delete Namespace…"
      },
      {
        "command": "dryas.detailed.addProjectReference",
        "title": "DRYAS: Add Project Reference…"
      },
      {
        "command": "dryas.detailed.removeProjectReference",
        "title": "DRYAS: Remove Project Reference"
      },
      {
        "command": "dryas.detailed.openReferencedProject",
        "title": "DRYAS: Open Referenced Project"
      }
    ],
    "configuration": {
      "title": "DRYAS Systrace",
      "properties": {
        "dryas.lspPath": {
          "type": "string",
          "default": "sysml-lsp",
          "scope": "machine-overridable",
          "description": "Language engine LSP executable: absolute path, or sysml-lsp on PATH."
        },
        "dryas.apiPath": {
          "type": "string",
          "default": "sysml-grpc",
          "scope": "machine-overridable",
          "description": "Language engine API executable: absolute path, or sysml-grpc on PATH."
        },
        "dryas.modelRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "."
          ],
          "scope": "resource",
          "description": "Fallback source folders for projects without .systrace/project.json. Use Configure Model Source Folders to save a shared project scope."
        },
        "dryas.expectedEngineVersion": {
          "type": "string",
          "default": "v0.9.2-dryas.6",
          "scope": "resource",
          "description": "Required language engine build version, checked before use."
        },
        "dryas.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "scope": "resource",
          "description": "Deadline for a language engine request in milliseconds."
        },
        "dryas.projectTree.displayMode": {
          "type": "string",
          "default": "compact",
          "enum": [
            "compact",
            "detailed"
          ],
          "enumItemLabels": [
            "Compact — one line",
            "Detailed — two lines"
          ],
          "enumDescriptions": [
            "Show the element name and type on one line, with its kind beside it.",
            "Show the element name above its kind and type."
          ],
          "scope": "application",
          "description": "Personal project-tree display preference. Applies to all projects without changing model files or engine sessions."
        }
      }
    },
    "views": {
      "systrace": [
        {
          "id": "systrace.projects",
          "name": "Projects",
          "when": "config.dryas.projectTree.displayMode != detailed"
        },
        {
          "id": "systrace.projectsDetailed",
          "name": "Projects",
          "type": "webview",
          "when": "config.dryas.projectTree.displayMode == detailed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "systrace.projects",
        "contents": "Create a project or open an existing folder. Model files can be placed anywhere inside the project root.\n[New Project](command:dryas.createProject)\n[Open Project](command:dryas.openProject)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dryas.newNamespace",
          "when": "view == systrace.projects || view == systrace.projectsDetailed",
          "group": "navigation@1"
        },
        {
          "command": "dryas.createProject",
          "when": "view == systrace.projects || view == systrace.projectsDetailed",
          "group": "navigation"
        },
        {
          "command": "dryas.openProject",
          "when": "view == systrace.projects || view == systrace.projectsDetailed",
          "group": "navigation"
        },
        {
          "command": "dryas.refreshProjects",
          "when": "view == systrace.projects || view == systrace.projectsDetailed",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dryas.newNamespaceInFolder",
          "when": "view == systrace.projects && (viewItem == systraceProject || viewItem == systracesource || viewItem == systracedirectory)",
          "group": "0_create"
        },
        {
          "command": "dryas.selectProject",
          "when": "view == systrace.projects && viewItem == systraceProject",
          "group": "1_project"
        },
        {
          "command": "dryas.validateProject",
          "when": "view == systrace.projects && viewItem == systraceProject",
          "group": "2_tools"
        },
        {
          "command": "dryas.configureModelRoots",
          "when": "view == systrace.projects && viewItem == systraceProject",
          "group": "2_tools"
        },
        {
          "command": "dryas.closeProject",
          "when": "view == systrace.projects && viewItem == systraceProject",
          "group": "3_close"
        },
        {
          "command": "dryas.deleteNamespace",
          "when": "view == systrace.projects && viewItem == systraceNamespaceFile",
          "group": "3_delete"
        },
        {
          "command": "dryas.addProjectReference",
          "when": "view == systrace.projects && (viewItem == systraceProject || viewItem == systracereferences)",
          "group": "1_references"
        },
        {
          "command": "dryas.removeProjectReference",
          "when": "view == systrace.projects && viewItem == systraceProjectReference",
          "group": "1_references"
        },
        {
          "command": "dryas.openReferencedProject",
          "when": "view == systrace.projects && (viewItem == systraceProjectReference || viewItem == systraceTransitiveReference)",
          "group": "1_references"
        }
      ],
      "explorer/context": [
        {
          "command": "dryas.openProject",
          "when": "explorerResourceIsFolder && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dryas.newNamespaceInFolder",
          "when": "false"
        },
        {
          "command": "dryas.deleteNamespace",
          "when": "false"
        },
        {
          "command": "dryas.removeProjectReference",
          "when": "false"
        },
        {
          "command": "dryas.openReferencedProject",
          "when": "false"
        },
        {
          "command": "dryas.detailed.selectProject",
          "when": "false"
        },
        {
          "command": "dryas.detailed.closeProject",
          "when": "false"
        },
        {
          "command": "dryas.detailed.validateProject",
          "when": "false"
        },
        {
          "command": "dryas.detailed.configureModelRoots",
          "when": "false"
        },
        {
          "command": "dryas.detailed.newNamespace",
          "when": "false"
        },
        {
          "command": "dryas.detailed.deleteNamespace",
          "when": "false"
        },
        {
          "command": "dryas.detailed.addProjectReference",
          "when": "false"
        },
        {
          "command": "dryas.detailed.removeProjectReference",
          "when": "false"
        },
        {
          "command": "dryas.detailed.openReferencedProject",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "dryas.detailed.selectProject",
          "when": "webviewId == systrace.projectsDetailed && (webviewSection == systraceProject)",
          "group": "systrace"
        },
        {
          "command": "dryas.detailed.closeProject",
          "when": "webviewId == systrace.projectsDetailed && (webviewSection == systraceProject)",
          "group": "systrace"
        },
        {
          "command": "dryas.detailed.validateProject",
          "when": "webviewId == systrace.projectsDetailed && (webviewSection == systraceProject)",
          "group": "systrace"
        },
        {
          "command": "dryas.detailed.configureModelRoots",
          "when": "webviewId == systrace.projectsDetailed && (webviewSection == systraceProject)",
          "group": "systrace"
        },
        {
          "command": "dryas.detailed.newNamespace",
          "when": "webviewId == systrace.projectsDetailed && (webviewSection == systraceProject || webviewSection == systracesource || webviewSection == systracedirectory)",
          "group": "systrace"
        },
        {
          "command": "dryas.detailed.deleteNamespace",
          "when": "webviewId == systrace.projectsDetailed && (webviewSection == systraceNamespaceFile)",
          "group": "systrace"
        },
        {
          "command": "dryas.detailed.addProjectReference",
          "when": "webviewId == systrace.projectsDetailed && (webviewSection == systraceProject || webviewSection == systracereferences)",
          "group": "systrace"
        },
        {
          "command": "dryas.detailed.removeProjectReference",
          "when": "webviewId == systrace.projectsDetailed && (webviewSection == systraceProjectReference)",
          "group": "systrace"
        },
        {
          "command": "dryas.detailed.openReferencedProject",
          "when": "webviewId == systrace.projectsDetailed && (webviewSection == systraceProjectReference || webviewSection == systraceTransitiveReference)",
          "group": "systrace"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "systrace",
          "title": "Systrace",
          "icon": "media/systrace.svg"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "dryas_editor_diagnostics",
        "displayName": "Systrace: Current Window Problems",
        "toolReferenceName": "systraceProblems",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Read current-window SysML/KerML Problems, including all severities, unsaved documents and library diagnostics. Returns observation editor and each project language-service connection state with index unconfirmed. Reads existing diagnostics even when disconnected. Does not run validation, save documents or connect to another window. An empty list is only an empty Problems snapshot, not evidence of complete checking.",
        "userDescription": "Read SysML/KerML diagnostics already present in this window, without saving or rechecking files.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      }
    ]
  },
  "dependencies": {
    "@dryas/engine-adapter": "0.1.0",
    "vscode-languageclient": "10.1.2"
  }
}
